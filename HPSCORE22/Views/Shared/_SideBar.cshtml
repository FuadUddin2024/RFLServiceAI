<script>
    document.addEventListener("DOMContentLoaded", function () {
        const dashboardMenu = document.querySelector('.nav-item.has-treeview');

        if (dashboardMenu) {
            dashboardMenu.classList.add('menu-open');
            dashboardMenu.querySelector('.nav-link').classList.add('active');
        }
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const currentUrl = window.location.pathname;
        document.querySelectorAll('.nav-treeview a').forEach(link => {
            if (link.getAttribute('href') === currentUrl) {
                link.classList.add('active');
                link.closest('.nav-item').classList.add('menu-open');
                link.closest('.nav-item').querySelector('.nav-link').classList.add('active');
            }
        });
    });
</script>
