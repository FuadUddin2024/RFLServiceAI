@model QCMS.Models.QCCompany

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        @(string.IsNullOrEmpty(Model.COMPANY_ID) ? "➕ Add Company" : "✏️ Edit Company")
                    </h5>
                </div>

                <div class="card-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form method="post" asp-action="Save">

@*                      <div class="mb-3">
                            <label class="form-label">Company ID</label>
                            <input asp-for="COMPANY_ID" class="form-control" placeholder="Enter ID" />
                        </div>
 *@
                        <input asp-for="COMPANY_ID" type="hidden" />
                        <div class="mb-3">
                            <label class="form-label">Company Name</label>
                            <input asp-for="COMPANY_NAME" class="form-control" placeholder="Enter Company Name" />
                        </div>
                     @*    <div class="mb-2">
                            <label>Active</label>
                            <select asp-for="IS_ACTIVE" class="form-control">
                                <option value="1">Yes</option>
                                <option value="0">No</option>
                            </select>
                        </div> *@

                        <div class="d-flex justify-content-between">
                            <a asp-area="" asp-controller="QCCompany" asp-action="index" class="btn btn-secondary">
                                ← Back
                            </a>

                            <button type="submit" class="btn btn-success">
                                💾 Save
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>