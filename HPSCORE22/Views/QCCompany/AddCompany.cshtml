
<br />
<div class="card card-outline card-primary shadow-sm">
    <div class="card-header d-flex align-items-center">
        <h3 class="card-title mb-0">
            <i class="fas fa-vial mr-2"></i> Test Setup Form
        </h3>
    </div>

    <form>
        <div class="card-body">

            <!-- Row 1 -->
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label><i class="fas fa-tag mr-1"></i> Test Name</label>
                        <input type="text" class="form-control form-control-lg"
                               placeholder="Enter Test Name">
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label><i class="fas fa-balance-scale mr-1"></i> Unit</label>
                        <select class="form-control form-control-lg">
                            <option value="">Select Unit</option>
                            <option>kg</option>
                            <option>mm</option>
                            <option>°C</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Row 2 -->
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label><i class="fas fa-cogs mr-1"></i> Method</label>
                        <select class="form-control">
                            <option value="">Select Method</option>
                            <option>Manual</option>
                            <option>Automatic</option>
                            <option>Digital</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label><i class="fas fa-arrow-down mr-1"></i> Min Value</label>
                        <input type="number" class="form-control"
                               placeholder="Enter Min Value">
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label><i class="fas fa-arrow-up mr-1"></i> Max Value</label>
                        <input type="number" class="form-control"
                               placeholder="Enter Max Value">
                    </div>
                </div>
            </div>

        </div>

        <!-- Footer -->
        <div class="card-footer d-flex justify-content-between">
            <div>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fas fa-save mr-1"></i> Submit
                </button>
                <button type="reset" class="btn btn-outline-secondary px-4">
                    <i class="fas fa-undo mr-1"></i> Reset
                </button>
            </div>

            <button type="button" class="btn btn-light">
                <i class="fas fa-times mr-1"></i> Cancel
            </button>
        </div>
    </form>
</div>


