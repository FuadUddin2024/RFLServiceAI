@model CSWMS.Models.ViewModel.SalesReturnViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- ADD JQUERY -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
      rel="stylesheet" />
<div class="container">

    <div class="row">

        <div class="card shadow-sm border-0 mt-3">

            <div class="card-header" style="background-color: lightskyblue;">
                <h4>
                    Sales Return Info
                </h4>
            </div>

            @using (Html.BeginForm("FeedbackSave", "FeedbackList", FormMethod.Post, new { @class = "form-inline" }))
            {

                <div class="card-body">

                    <div class="row" style="padding:2%">
                        <div class="col-md-4">
                            <label>Ticket ID</label>
                            @Html.TextBoxFor(m => m.FeedBackDetails.TicketID,new { @class = "form-control",id = "TickedID"})
                    </div>
                    <div class="col-md-4">
                        <label>Customer Name</label>
                        @Html.TextBoxFor(
                                                m => m.FeedBackDetails.CustomerName,
                                                new { @class = "form-control", @readonly = "readonly",id="customername" })
                    </div>
                    <div class="col-md-4">
                        <label>Contact No</label>
                        @Html.TextBoxFor(
                                                m => m.FeedBackDetails.CustomerContactNo,
                                                new { @class = "form-control", @readonly = "readonly", id = "Contactnumber" })
                    </div>
                    <div class="col-md-4">
                        <label>Location</label>
                        @Html.TextAreaFor(
                                                m => m.FeedBackDetails.CustomerAddress,
                                                new { @class = "form-control", @readonly = "readonly", id = "customerlocation" })
                    </div>
                    <div class="col-md-4">
                        <label>Product</label>
                        @Html.TextBoxFor(
                                                m => m.FeedBackDetails.ProductName,
                                                new { @class = "form-control", @readonly = "readonly", id = "customerproduct" })
                    </div>
                    <div class="col-md-4">
                        <label>Model Name</label>
                        @Html.HiddenFor(m => m.FeedBackDetails.PrModelId, new { @class = "form-control", id = "customermodel", @readonly = "readonly" })
                        <input type="text" class="form-control" id="modelname" name="fname" readonly>
                    </div>
                    <div class="col-md-4">
                        <label>
                            Product Serial No
                        </label>
                        @Html.TextBoxFor(m => m.FeedBackDetails.SerialNo, new { @class = "form-control", id = "productname", @readonly = "readonly" })
                    </div>
                    <div class="col-md-4">
                        <label>
                            Sales Date
                        </label>
                        @Html.TextBoxFor(m => m.FeedBackDetails.PurchaseDate,
                                                new { @class = "form-control", @type = "date", id = "purchasedate", @readonly = "readonly" })
                    </div>
                    <div class="col-md-4">
                        <label>Problem Name</label>
                        @Html.HiddenFor(m => m.FeedBackDetails.ActualProblemId, new { @class = "form-control", id = "actualprobid" })
                        <input type="text" id="problemname" name="fname" class="form-control" readonly>
                    </div>
                    <div class="col-md-4">
                        <label>
                            Sales Return Info
                        </label>
                        @Html.TextAreaFor(m => m.FeedBackDetails.SRInfo, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label>Dealer Code</label>
                        @Html.TextBoxFor(m => m.FeedBackDetails.DillerCode, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label>Dealer Code</label>
                        @Html.TextBoxFor(m => m.FeedBackDetails.DillerCode, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label>Depot Name</label>
                        @Html.DropDownListFor(
                                                m => m.FeedBackDetails.DillerCode,
                                                new SelectList(
                                                Model.DepotList,
                                                "DepotId",
                                                "DepotName"
                                                ),
                                                "Select Depot",
                                                new
                                                {
                                                    @class = "form-control",
                                                    id = "BrandID"
                                                })
                    </div>

                    <div class="col-md-4">
                        <label>
                            File Upload
                        </label>
                        <input class="form-control" type="file" id="formFile">
                    </div>
                </div>

            </div>

             }

        </div>

    </div>

</div>

