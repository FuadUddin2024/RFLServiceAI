@model CSWMS.Models.ViewModel.SalesReturnViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="~/Views/Shared/PartialView/_CSSCDNLink.cshtml" />

<!-- ADD JQUERY -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
      rel="stylesheet" />
<div class="container">

    <div class="row">

        <div class="card shadow-sm border-0 mt-3">

            <div class="card-header" style="background-color: lightskyblue;">
                <h4>
                    Sales Return Info
                </h4>
            </div>

            @using (Html.BeginForm("FeedbackSave", "FeedbackList", FormMethod.Post, new { @class = "form-inline" }))
            {

                <div class="card-body">

                    <div class="row" style="padding:2%">
                        <div class="col-md-4">
                            <label>Ticket ID</label>
                            @Html.TextBoxFor(m => m.FeedBackDetails.TicketID,new { @class = "form-control",id = "TickedID"})
                    </div>
                    <div class="col-md-4">
                        <label>Customer Name</label>
                        @Html.TextBoxFor(
                                                m => m.FeedBackDetails.CustomerName,
                                                new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-4">
                        <label>Contact No</label>
                        @Html.TextBoxFor(
                                                m => m.FeedBackDetails.CustomerContactNo,
                                                new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-4">
                        <label>Location</label>
                        @Html.TextAreaFor(
                                                m => m.FeedBackDetails.CustomerAddress,
                                                new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-4">
                        <label>Product</label>
                        @Html.TextBoxFor(
                                                m => m.FeedBackDetails.ProductName,
                                                new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-4">
                        <label>Model Name</label>
                        @Html.HiddenFor(m => m.FeedBackDetails.PrModelId, new { @class = "form-control", @readonly = "readonly" })
                        <input type="text" id="fname" name="fname" readonly>
                    </div>
                    <div class="col-md-4">
                        <label>
                            Product Serial No
                        </label>
                        @Html.TextBoxFor(m => m.FeedBackDetails.SerialNo,new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label>
                            Sales Date
                        </label>
                        @Html.TextBoxFor(
                                                m => m.FeedBackDetails.PurchaseDate,
                                                new { @class = "form-control", @type = "date" })
                    </div>
                    <div class="col-md-4">
                        <label>Problem Name</label>
                        @Html.HiddenFor(m => m.FeedBackDetails.ActualProblemId, new { @class = "form-control", @readonly = "readonly" })
                        <input type="text" id="pname" name="fname" readonly>
                    </div>
                    <div class="col-md-4">
                        <label>Location</label>
                        @Html.TextAreaFor(m => m.FeedBackDetails.SRInfo, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label>Dealer Code</label>
                        @Html.TextAreaFor(m => m.FeedBackDetails.DillerCode, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label>Dealer Code</label>
                        @Html.TextAreaFor(m => m.FeedBackDetails.DillerCode, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label>Depot Name</label>
                        @Html.DropDownListFor(
                                                m => m.FeedBackDetails.DillerCode,
                                                new SelectList(
                                                Model.DepotList,
                                                "DepotId",
                                                "DepotName"
                                                ),
                                                "Select Depot",
                                                new
                                                {
                                                    @class = "form-control",
                                                    id = "BrandID"
                                                })
                    </div>

                    <div class="col-md-4">
                        <label>
                            File Upload
                        </label>
                        <input class="form-control" type="file" id="formFile">
                    </div>
                </div>

            </div>

                        }

        </div>

    </div>

</div>

<script>

    $(document).ready(function () {
    $("#subproblemID").select2({
        placeholder: "Select Sub Problems",
        allowClear: true,
        width: "100%"
    });
        // Ticket ID CHANGE
        $("#TickedID").change(function () {

            var brandId = $(this).val();

            $("#classID").empty();
            $("#classID").append(
                '<option value="">Select Class</option>'
            );

            $("#productID").empty();
            $("#productID").append(
                '<option value="">Select Product</option>'
            );

            if (brandId != "") {

                $.ajax({

                    url: '@Url.Action("GetAllClassProducts", "FeedbackList")',

                    type: "POST",

                    data: {
                        BrandID: brandId
                    },

                    success: function (data) {

                        $.each(data.Filtereddata,
                            function (i, item) {

                                $("#classID").append(

                                    '<option value="' +
                                    item.ItemId +
                                    '">' +
                                    item.ItemName +
                                    '</option>'

                                );

                            });
                    },

                    error: function () {

                        alert("Class Load Failed");

                    }

                });

            }

        });
        // CLASS CHANGE
        $("#classID").change(function () {
            var classId = $(this).val();

            $("#productID").empty();

            $("#productID").append(
                '<option value="">Select Product</option>'
            );

            if (classId != "") {

                $.ajax({

                    url: '@Url.Action("GetAllProducts", "FeedbackList")',

                    type: "POST",

                    data: {
                        ItemID: classId
                    },

                    success: function (data) {

                        $.each(data.Filtereddata,
                            function (i, item) {

                                $("#productID").append(

                                    '<option value="' +
                                    item.ProductId +
                                    '">' +
                                    item.ProductName +
                                    '</option>'

                                );

                            });
                               $.each(data.NatureofProblem,
                            function (i, item) {

                                $("#productID").append(

                                    '<option value="' +
                                    item.problemId +
                                    '">' +
                                    item.ProblemName +
                                    '</option>'

                                );

                            });

                    },

                    error: function () {

                        alert("Product Load Failed");

                    }

                });

            }

        });
        $("#productID").change(function () {
            var classId = $(this).val();

            $("#actualproID").empty();

            $("#actualproID").append(
                '<option value="">Select Product</option>'
            );

            if (classId != "") {

                $.ajax({

                    url: '@Url.Action("GetAllActualProblem", "FeedbackList")',

                    type: "POST",

                    data: {
                        productID: classId
                    },

                    success: function (data) {
                               $.each(data.NatureofProblem,
                            function (i, item) {

                                $("#actualproID").append(

                                    '<option value="' +
                                    item.problemId +
                                    '">' +
                                    item.ProblemName +
                                    '</option>'

                                );

                            });

                    },

                    error: function () {

                        alert("Product Load Failed");

                    }

                });

            }

        });
        $("#actualproID").change(function () {

        var classId = $(this).val();

        $("#subproblemID").empty();

        if (classId != "") {

            $.ajax({

                url: '@Url.Action("GetAllSubProblems", "FeedbackList")',

                type: "POST",

                data: {
                    ProblemID: classId
                },

                success: function (data) {

                    $.each(data.NatureofSubProblem, function (i, item) {

                        $("#subproblemID").append(

                            $('<option>', {
                                value: item.SubProblemID,
                                text: item.SubProblemName
                            })

                        );

                    });

                    // Refresh Select2
                    $("#subproblemID").trigger("change");

                },

                error: function () {

                    alert("Sub Problem Load Failed");

                }

            });

        }

    });
    });

</script>