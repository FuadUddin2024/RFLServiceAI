        function setPositiveGrowth(circleId, arrowId, textId, growth) {

            $("#" + textId).text(Math.abs(growth) + "%");

            if (growth >= 0) {
                $("#" + circleId)
                    .removeClass("growth-down")
                    .addClass("growth-up");

                $("#" + arrowId)
                    .html("▲")
                    .removeClass("arrow-down")
                    .addClass("arrow-up");
            }
            else {
                $("#" + circleId)
                    .removeClass("growth-up")
                    .addClass("growth-down");

                $("#" + arrowId)
                    .html("▼")
                    .removeClass("arrow-up")
                    .addClass("arrow-down");
            }
        }
        function setNegativeGrowth(circleId, arrowId, textId, growth) {

            $("#" + textId).text(Math.abs(growth) + "%");

            if (growth > 0) {

                // More complaints / pending / cancel
                // BAD

                $("#" + circleId)
                    .removeClass("growth-up")
                    .addClass("growth-down");

                $("#" + arrowId)
                    .html("▲")
                    .removeClass("arrow-up")
                    .addClass("arrow-down");
            }
            else {

                // Reduced complaint / pending / cancel
                // GOOD

                $("#" + circleId)
                    .removeClass("growth-down")
                    .addClass("growth-up");

                $("#" + arrowId)
                    .html("▼")
                    .removeClass("arrow-down")
                    .addClass("arrow-up");
            }
        }

