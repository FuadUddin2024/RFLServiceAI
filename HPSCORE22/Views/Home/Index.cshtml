@{
    ViewData["Title"] = "Service & Warranty Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ================= INLINE PAGE CSS (NO SECTION) ================= -->
<style>

    /* ===== KPI CARDS START ===== */

    .kpi-box {
        min-height: 75px !important;
        border-radius: 12px;
        overflow: hidden;
        transition: all .3s ease;
        box-shadow: 0 3px 10px rgba(0,0,0,.08);
        position: relative;
    }

    .kpi-box:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(0,0,0,.15);
    }

    .kpi-box .inner {
        padding: 12px 15px;
    }

    .kpi-box h4 {
        font-size: 24px;
        font-weight: 700;
        margin: 0;
        color: #fff;
    }

    .kpi-box p {
        margin: 2px 0 0;
        font-size: 13px;
        color: rgba(255,255,255,.9);
        font-weight: 500;
    }

    /* Icon Watermark */
    .kpi-box .icon {
        position: absolute;
        right: 12px;
        top: 8px;
        font-size: 38px;
        opacity: .18;
        color: #fff;
    }

    /* Custom Colors */

    .bg-service {
        background: linear-gradient(135deg,#2563eb,#1d4ed8);
    }

    .bg-tech {
        background: linear-gradient(135deg,#475569,#334155);
    }

    .bg-supervisor {
        background: linear-gradient(135deg,#16a34a,#15803d);
    }

    .bg-sla-total {
        background: linear-gradient(135deg,#7c3aed,#5b21b6);
    }

    .bg-sla-last {
        background: linear-gradient(135deg,#ea580c,#c2410c);
    }

    .bg-sla-this {
        background: linear-gradient(135deg,#0891b2,#0e7490);
    }
    /* ===== KPI CARDS END ===== */

    .kpi-box {
        min-height: 110px;
    }

    .small-box h4 {
        font-size: 28px;
        font-weight: 700;
    }

    .card-title {
        font-weight: 600;
    }

    canvas {
        max-height: 320px;
    }

    /* grouth */
    .growth-circle {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        margin: 10px auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        font-weight: bold;
        color: #fff;
        box-shadow: 0 3px 10px rgba(0,0,0,.15);
    }

    .growth-up {
        background: #28a745;
    }

    .growth-down {
        background: #dc3545;
    }

    .growth-icon {
        font-size: 24px;
        line-height: 20px;
    }

    .growth-value {
        font-size: 18px;
    }

    .kpi-card table td,
    .kpi-card table th {
        padding: 8px;
    }

    .kpi-card .card-body {
        min-height: 300px;
    }

    /* Managers CSS */

    .operations {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(320px,1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .manager-card {
        background: #fff;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 2px 12px rgba(0,0,0,.08);
    }

    .manager-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 15px;
    }

    .manager-header img {
        width: 60px;
        height: 60px;
        border-radius: 50%;
    }

    .manager-stats {
        display: flex;
        justify-content: space-between;
    }

    .manager-stats div {
        text-align: center;
    }

    .manager-stats span {
        font-size: 12px;
        color: #64748b;
    }
    
    /*KPI Comparision*/
    .card-body h2 {
        font-size: 32px;
        font-weight: bold;
    }

    .table td,
    .table th {
        vertical-align: middle;
    }

