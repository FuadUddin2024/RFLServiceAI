    /* ================= Warranty Dashboard Style Start ================= */

    .warranty-card {
        border-radius: 12px;
        color: #fff;
        padding: 10px 14px;
        position: relative;
        overflow: hidden;
        min-height: 65px !important;
        transition: all .3s ease;
        cursor: pointer;
        box-shadow: 0 3px 10px rgba(0,0,0,.10);
    }

        .warranty-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(0,0,0,.15);
        }

        /* Watermark Icon */
        .warranty-card .icon {
            position: absolute;
            right: 10px;
            top: 8px;
            font-size: 28px;
            opacity: .18;
            color: #fff;
        }

        /* Main Number */
        .warranty-card h3 {
            font-size: 20px;
            font-weight: 700;
            margin: 0;
            line-height: 1.1;
        }

        /* Title */
        .warranty-card p {
            margin: 2px 0 0;
            font-size: 12px;
            font-weight: 500;
            line-height: 1.2;
        }

        /* Subtitle */
        .warranty-card .sub {
            font-size: 10px;
            opacity: .85;
            margin-top: 3px;
            line-height: 1.2;
        }

    /* Gradient Backgrounds */

    .bg-total {
        background: linear-gradient(135deg, #2563eb, #1e40af);
    }

    .bg-in {
        background: linear-gradient(135deg, #16a34a, #15803d);
    }

    .bg-out {
        background: linear-gradient(135deg, #dc2626, #991b1b);
    }

    .bg-percent {
        background: linear-gradient(135deg, #7c3aed, #5b21b6);
    }

    .bg-found {
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }

    .bg-notfound {
        background: linear-gradient(135deg, #475569, #334155);
    }

    /* warranty style end */

</style>

