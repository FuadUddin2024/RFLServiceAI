@model CSWMS.Models.ViewModel.ComplainViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    body {
        background: #f5f7fb;
    }

    .dt-buttons.btn-group.flex-wrap {
        display: none;
    }

    .table-container {
        background: white;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,.06);
        margin-top: 20px;
    }

    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .table-header h4 {
            margin: 0;
            font-weight: 700;
        }

    /* Header */
    #example1 thead {
        background: #1f2937;
        color: white;
    }

        #example1 thead th {
            padding: 16px;
            border: none;
        }

    /* Rows */

    #example1 tbody tr {
        transition: .3s;
    }

        #example1 tbody tr:hover {
            background: #f0f7ff;
        }

    #example1 tbody td {
        padding: 15px;
        vertical-align: middle;
    }

    /* Zebra */
    #example1 tbody tr:nth-child(even) {
        background: #fafafa;
    }

    /* Search */
    .dataTables_filter input {
        border-radius: 10px !important;
        padding: 10px !important;
        border: 1px solid #ddd !important;
    }

    /* Length */
    .dataTables_length select {
        border-radius: 8px;
    }

    /* Pagination */

    .dataTables_paginate .paginate_button {
        border-radius: 8px !important;
        margin: 2px !important;
    }

        .dataTables_paginate .paginate_button.current {
            background: #0d6efd !important;
            color: white !important;
            border: none !important;
        }

    /* Info */

    .dataTables_info {
        color: #777;
    }

    /* Buttons */

    .action-btn {
        border: none;
        padding: 8px 14px;
        border-radius: 8px;
    }

    .edit {
        background: #198754;
        color: white;
    }

    .view {
        background: #0dcaf0;
    }

    .delete {
        background: #dc3545;
        color: white;
    }

    .dataTables_scrollHeadInner {
        width: 100% !important;
    }

    .table.table-bordered.table-striped.table-hover.w-100.dataTable.no-footer {
        margin-left: -6px !important;
    }

    .modal-header {
        display: flex;
        justify-content: center;
        align-content: center;
        background-color: cornflowerblue;
    }

    .assignlable {
        font-size: 14px;
    }
</style>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<script src='https://kit.fontawesome.com/a076d05399.js' crossorigin='anonymous'></script>

<div class="card tablebody">
    <div class="card-header TableHeader">
        <h3 class="card-title tableheadertext" style="color: white !important">Assign Technicians</h3>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <table id="locationTable" class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Ticket ID</th>
                    <th>Customer Name</th>
                    <th>Contact No</th>
                    <th>Location</th>
                    <th>Product Name</th>
                    <th>Problem Name</th>
                    <th>Zone Name</th>
                    <th>Supervisor Name</th>
                    <th>Complain Date</th>
                    <th>Assign Tasks</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.AssignList)
                {
                    <tr>
                        <td>@item.TicketID</td>
                        <td>@item.CustomerName</td>
                        <td>@item.CustomerContactNo</td>
                        <td>@item.CustomerAddress</td>
                        <td>@item.ProductName</td>
                        <td>@item.ProblemName</td>
                        <td>@item.ZoneName</td>
                        <td>@item.SupervisorName</td>
                        <td>@item.EntryDate</td>
                        <td class="text-center">
                            <button class="btn btn-primary btn-sm assign-btn"
                                    data-id="@item.TicketID">
                                <i class="fas fa-user-plus"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
    <!-- /.card-body -->
</div>
<!-- ✅ ASSIGN MODAL (BOOTSTRAP 5) -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            @using (Html.BeginForm("SaveAssignDataWithTechnician", "ComplainList", FormMethod.Post, new { enctype = "multipart/form-data", id = "myForm" }))
            {
                <div class="modal-header">
                    <h5 class="modal-title" style="text-align:center !important">
                        Assign Technician <i class='fas fa-user-tie'></i>
                    </h5>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-4 mb-2">
                            <label class="assignlable">Ticket ID</label>
                            @Html.TextBoxFor(m => m.AssignModel.TicketID, new { @class = "form-control", @readonly = "readonly", id = "txtTicketID" })
                            @*  <input type="text" id="ticketDisplay" class="form-control" disabled /> *@
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="assignlable">Customer Name</label>
                            @Html.TextBoxFor(m => m.AssignModel.CustomerName, new { @class = "form-control", @readonly = "readonly", id = "txtcustomername" })
                            @*  <input type="text" id="customerName" class="form-control" disabled /> *@
                        </div>
                        <div class="col-md-4 mb-2">
                        <label class="assignlable">Customer ContactNo</label>
                            @Html.TextBoxFor(m => m.AssignModel.CustomerContactNo, new { @class = "form-control", @readonly = "readonly", id = "txtContactNumber" })
                        @*   <input type="text" id="productName" class="form-control" disabled /> *@
                    </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-2">
                            <label class="assignlable">Location</label>
                            @*  <input type="text" id="productName" class="form-control" disabled /> *@
                            @Html.TextBoxFor(m => m.AssignModel.CustomerAddress, new { @class = "form-control", id = "txtlocationname" })
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="assignlable">Product Name</label>
                            @Html.TextBoxFor(m => m.AssignModel.ProductName, new { @class = "form-control", id = "txtproductname" })
                            @*  <input type="text" id="productName" class="form-control" disabled /> *@
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="assignlable">Status <span style="color:red;">*</span></label>
                           @Html.HiddenFor(m => m.AssignModel.StatusId,new {id="hiddenstatus"})
                            @Html.DropDownListFor(
                            m => m.AssignModel.StatusId,
                                                new SelectList(Model.StatusList, "StatusId", "StatusName"),
                                                "Select Status",
                                                new { @class = "form-control", disabled = "disabled", id = "txtStatusID" }
                                                )
                        @Html.ValidationMessageFor(m => m.AssignModel.StatusId, "", new { @class = "text-danger" })
                    </div>
                    </div>
                    <div class="row">
                     <div class="col-md-4 mb-2">
                        <label class="assignlable">Assign To</label>
                        @Html.DropDownListFor(
                                                m => m.AssignModel.TechnicianId,
                                                new SelectList(Model.TechnicianList, "TechnicianId", "TechName"),
                                                "Select Technician",
                                                new { @class = "form-control", id = "txtTechnician" }
                                                )
                        @Html.ValidationMessageFor(m => m.AssignModel.TechnicianId, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="assignlable">Assign Supervisor <span style="color:red;">*</span></label>
                        @Html.HiddenFor(m => m.AssignModel.SupervisorId, new { id = "hiddensupervisor" })
                        @Html.DropDownListFor(
                                                m => m.AssignModel.SupervisorId,
                                                new SelectList(Model.SuperVisorList, "SupervisorId", "SupervisorName"),
                                                "Select SuperVisor",
                                                new { @class = "form-control txtSupervisorName", disabled = "disabled", id = "AssingedZonesupervisor" }
                                                )
                        @Html.ValidationMessageFor(m => m.AssignModel.SupervisorId, "", new { @class = "text-danger"  })
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="assignlable">Assign Company <span style="color:red;">*</span></label>
                        @Html.HiddenFor(m => m.AssignModel.CompanyId, new { id = "hiddenCompanyID" })
                        @Html.DropDownListFor(
                                                m => m.AssignModel.CompanyId,
                                                new SelectList(Model.CompanyList, "CompanyId", "CompanyName"),
                                                "Select Company",
                                                new { @class = "form-control", id = "txtCompany", disabled = "disabled" }
                                                )
                        @*  <input type="text" id="productName" class="form-control" disabled /> *@
                        @Html.ValidationMessageFor(m => m.AssignModel.CompanyId, "", new { @class = "text-danger", @readonly = "readonly" })
                    </div>
                    </div>
                    <div class="row">
                    <div class="col-md-4 mb-2">
                            <label class="assignlable">Assign Zone <span style="color:red;">*</span></label>
                        @Html.HiddenFor(m => m.AssignModel.AssignZoneId, new { id = "hiddenZoneID" })
                            @Html.DropDownListFor(
                            m => m.AssignModel.AssignZoneId,
                                                new SelectList(Model.ZoneList, "ZoneId", "ZoneName"),
                                                "Select Zone",
                                                new { @class = "form-control", id = "AssingedZone", disabled = "disabled" }
                                                )
                        @Html.ValidationMessageFor(m => m.AssignModel.AssignZoneId, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="assignlable">Finish Date <span style="color:red;">*</span></label>
                        @Html.TextBoxFor(m => m.AssignModel.FinishDate, new { @class = "form-control", type = "date", id = "txtFinishDate" })
                        @*   <input type="date" id="productName" class="form-control" disabled /> *@
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="assignlable">Remarks</label>
                        @Html.TextBoxFor(m => m.AssignModel.Remarks, new { @class = "form-control", id = "txtremark" })
                        @*    <input type="text" id="productName" class="form-control" disabled /> *@
                    </div>
                </div>
                </div>

            <div class="modal-footer">
                <button class="btn btn-success" type="button" id="btnSaveAssign">Assign</button>
                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal" style="background-color:red">Close</button>
            </div>
                        }
        </div>
    </div>
</div>

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!--Data Table-->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script>
    $(document).ready(function () {
        $('#locationTable').DataTable({
            pageLength: 5,
            lengthMenu: [5, 10, 25, 50],
            ordering: true,
            searching: true,
            paging: true,
            info: true,
            autoWidth: false,
            responsive: true, // ✅ better UI

            language: {
                search: "🔍 Search:",
                lengthMenu: "Show _MENU_ entries",
                zeroRecords: "No matching locations found",
                info: "Showing _START_ to _END_ of _TOTAL_ locations",
                infoEmpty: "No data available"
            },

            columnDefs: [
                { orderable: false, targets: 5 } // action column
            ]
        });
    });

    function confirmDelete() {
        return confirm("⚠️ Are you sure you want to delete?");
    }
</script>
<script>
    $(document).on('click', '.assign-btn', function () {

        var id = $(this).data('id');

        $.ajax({
            url: '/ComplainList/GetAssignSingle',
            type: 'GET',
            data: { id: id },

            success: function (res) {

                debugger;
                console.log("Response:", res);

                if (!res || !res.complainList) {
                    alert("No data found");
                    return;
                }

                var data = res.complainList;

                console.log("Data:", data);

                // Inputs
                $('#txtTicketID').val(data.TicketID || '');
                $('#txtcustomername').val(data.CustomerName || '');
                $('#txtContactNumber').val(data.CustomerContactNo || '');
                $('#txtlocationname').val(data.CustomerAddress || '');
                $('#txtproductname').val(data.ProductName || '');

                // Dropdowns
                $('#txtStatusID').val(data.StatusId).trigger('change');
                $('#hiddenstatus').val(data.StatusId);

                $('#AssingedZonesupervisor').val(data.SupervisorId).trigger('change');
                $('#hiddensupervisor').val(data.SupervisorId);

                $('#txtCompany').val(data.CompanyId).trigger('change');
                $('#hiddenCompanyID').val(data.CompanyId);

                $('#AssingedZone').val(data.AssignZoneId).trigger('change');
                $('#hiddenZoneID').val(data.AssignZoneId);

                // Technician dropdown
                var ddl = $('#txtTechnician');

                ddl.empty();
                ddl.append('<option value="">Select Technician</option>');
				console.log("Technician List:", res.TechnicianList);
                if (res.TechnicianList && res.TechnicianList.length > 0) {

                    $.each(res.TechnicianList, function (i, item) {

                        ddl.append(
                            `<option value="${item.TechnicianId}">
                                ${item.TechnicianName}
                            </option>`
                        );

                    });

                    ddl.val(data.TechnicianId).trigger('change');
                }

                // Date
                if (data.FinishDate) {
                    $('#txtFinishDate').val(data.FinishDate.substring(0, 10));
                } else {
                    $('#txtFinishDate').val('');
                }

                $('#txtremark').val(data.Remarks || '');

                bootstrap.Modal
                    .getOrCreateInstance(
                        document.getElementById('assignModal')
                    )
                    .show();
            },

            error: function (xhr) {
                console.log(xhr);
                alert('Error: ' + xhr.responseText);
            }
        });

    });
    $(document).on('change', '#AssingedZone', function () {

          var zoneId = $(this).val();

          $.ajax({
              url: '/ComplainList/GetZoneWiseSupervisor',
              type: 'GET',
              data: { zoneId: zoneId },
              dataType: 'json',
              success: function (res) {

                  console.log(res);

                  var ddl = $('#AssingedZonesupervisor');
                  ddl.empty();
                  ddl.append('<option value="">Select Supervisor</option>');

                      $.each(res.SupervisorList, function (i, item) {

                          ddl.append(
                              '<option value="' + item.SupervisorId + '">' +
                              item.SupervisorName +
                              '</option>'
                          );
                      });
              },
              error: function (xhr) {
                  console.log(xhr.responseText);
              }
          });
      });
    $('#btnSaveAssign').click(function () {

        var errors = [];

        $('.text-danger').text('');

        if ($('#AssingedZone').val() == '') {
            errors.push('Assign Zone is required');
        }

        if ($('#AssingedZonesupervisor').val() == '') {
            errors.push('Supervisor is required');
        }

        if ($('#AssignModel_CompanyId').val() == '') {
            errors.push('Company is required');
        }

        if ($('#AssignModel_StatusId').val() == '') {
            errors.push('Status is required');
        }

        if ($('#AssignModel_FinishDate').val() == '') {
            errors.push('Finish Date is required');
        }
        if (errors.length > 0) {

            alert(errors.join('\n'));

            return false; // modal remains open
        }

        $('#myForm').submit();

    });
</script>
<style>
    .fa-user-plus {
        cursor: pointer;
        transition: 0.3s;
    }

        .fa-user-plus:hover {
            color: #0d6efd;
            transform: scale(1.2);
        }
</style>