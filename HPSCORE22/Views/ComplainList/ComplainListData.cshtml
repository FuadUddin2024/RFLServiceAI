<!-- ✅ ASSIGN MODAL (BOOTSTRAP 5) -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            @using (Html.BeginForm("SaveAssignData", "ComplainList", FormMethod.Post, new { enctype = "multipart/form-data", id = "myForm" }))
        {
            <div class="modal-header">
                    <h5 class="modal-title">
                        Assign Setup
                    </h5>
            </div>

            <div class="modal-body">

               @*  <input type="hidden" id="ticketId" /> *@
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <label class="assignlable">Ticket ID</label>
                            @Html.TextBoxFor(m => m.AssignModel.TicketID, new { @class = "form-control", @readonly = "readonly", id = "txtTicketID" })
                       @*  <input type="text" id="ticketDisplay" class="form-control" disabled /> *@
                    </div>

                    <div class="col-md-4 mb-2">
                        <label class="assignlable">Customer Name</label>
                            @Html.TextBoxFor(m => m.AssignModel.CustomerName, new { @class = "form-control",id = "txtcustomername" })
                       @*  <input type="text" id="customerName" class="form-control" disabled /> *@
                    </div>

                    <div class="col-md-4 mb-2">
                        <label class="assignlable">Product Name</label>
                            @Html.TextBoxFor(m => m.AssignModel.ProductName, new { @class = "form-control", id = "txtproductname" })
                       @*  <input type="text" id="productName" class="form-control" disabled /> *@
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <label class="assignlable">Assign Zone <span style="color:red;">*</span></label>
                            @Html.DropDownListFor(
                            m => m.AssignModel.AssignZoneId,
                                                new SelectList(Model.ZoneList, "ZoneId", "ZoneName"),
                                                "Select Zone",
                                                new { @class = "form-control", id = "AssingedZone" }
                                                )
                        @Html.ValidationMessageFor(m => m.AssignModel.AssignZoneId, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="assignlable">Customer ContactNo</label>
                        @Html.TextBoxFor(m => m.AssignModel.CustomerContactNo, new { @class = "form-control", id = "txtContactNumber" })
                      @*   <input type="text" id="productName" class="form-control" disabled /> *@
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="assignlable">Assign Company <span style="color:red;">*</span></label>
                        @Html.DropDownListFor(
                                                m => m.AssignModel.CompanyId,
                                                new SelectList(Model.CompanyList, "CompanyId", "CompanyName"),
                                                "Select Company",
                                                new { @class = "form-control" }
                                                )
                       @*  <input type="text" id="productName" class="form-control" disabled /> *@
                        @Html.ValidationMessageFor(m => m.AssignModel.CompanyId, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <label class="assignlable">Location</label>
                       @*  <input type="text" id="productName" class="form-control" disabled /> *@
                        @Html.TextBoxFor(m => m.AssignModel.CustomerAddress, new { @class = "form-control", id = "txtlocationname" })
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="assignlable">Assign Supervisor <span style="color:red;">*</span></label>
                        @Html.DropDownListFor(
                                                m => m.AssignModel.SupervisorId,
                                                new SelectList(Model.SuperVisorList, "SupervisorId", "SupervisorName"),
                                                "Select SuperVisor",
                                                new { @class = "form-control", id = "AssingedZonesupervisor" }
                                                )
                        @Html.ValidationMessageFor(m => m.AssignModel.SupervisorId, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="assignlable">Status <span style="color:red;">*</span></label>
                        @Html.DropDownListFor(
                                                m => m.AssignModel.StatusId,
                                                new SelectList(Model.StatusList, "StatusId", "StatusName"),
                                                "Select Status",
                                                new { @class = "form-control" }
                                                )
                        @Html.ValidationMessageFor(m => m.AssignModel.StatusId, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <label class="assignlable">Finish Date <span style="color:red;">*</span></label>
                        @Html.TextBoxFor(m => m.AssignModel.FinishDate, new { @class = "form-control", type = "date" })
                      @*   <input type="date" id="productName" class="form-control" disabled /> *@
                    </div>
                  @*   <div class="col-md-4 mb-2">
                        <label class="assignlable">Assign To</label>
                        <select id="assignTo" class="form-control">
                            <option value="1">Technician A</option>
                            <option value="2">Technician B</option>
                        </select>
                    </div> *@
                    <div class="col-md-4 mb-2">
                        <label class="assignlable">Remarks</label>
                            @Html.TextBoxFor(m => m.AssignModel.Remarks, new { @class = "form-control" })
                     @*    <input type="text" id="productName" class="form-control" disabled /> *@
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-success" type="button" id="btnSaveAssign">Assign</button>
                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal" style="background-color:red">Close</button>
            </div>
        }
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="~/js/jquery-3.7.1.min.js"></script>
<script src="~/js/jquery.datatables.min.js"></script>
<script>
    $(document).ready(function () {

        LoadData();

    });

    function LoadData() {

        if ($.fn.DataTable.isDataTable('#example1')) {

            $('#example1')
                .DataTable()
                .clear()
                .destroy();

            $('#example1').empty();
        }

        $.ajax({

            url: '/ComplainList/GetAllComplainList',

            type: 'POST',

            dataType: 'json',

            success: function (res) {

                $('#example1').DataTable({

                    data: res.complainList || [],

                    responsive: true,

                    scrollX: true,

                    autoWidth: false,

                    processing: true,

                    destroy: true,

                    pageLength: 10,

                    lengthChange: false,

                    ordering: true,

                    searching: true,

                    info: true,

                    paging: true,

                    columns: [

                        {
                            title: "Ticket ID",
                            data: "TicketID",
                            defaultContent: ""
                        },

                        {
                            title: "Customer Name",
                            data: "CustomerName",
                            defaultContent: ""
                        },

                        {
                            title: "Contact No",
                            data: "ContactNo",
                            defaultContent: ""
                        },

                        {
                            title: "Location",
                            data: "Location",
                            defaultContent: ""
                        },

                        {
                            title: "Product Name",
                            data: "ProductName",
                            defaultContent: ""
                        },

                        {
                            title: "Problem Name",
                            data: "ProblemName",
                            defaultContent: ""
                        },

                        {
                            title: "Complain Date",

                            data: "EntryDate",

                            defaultContent: "",

                            render: function (data) {

                                if (!data)
                                    return "";

                                var d = new Date(data);

                                return d.toLocaleDateString(
                                    "en-GB",
                                    {
                                        day: "2-digit",
                                        month: "short",
                                        year: "numeric"
                                    }
                                );
                            }
                        },

                        {
                            title: "Assign",

                            data: "TicketID",

                            orderable: false,

                            searchable: false,

                            className: "text-center",

                            render: function (data) {

                                return `
                                    <button
                                        class="btn btn-primary btn-sm assign-btn"
                                        data-id="${data}">
                                        <i class="fas fa-user-plus"></i>
                                    </button>
                                `;
                            }
                        }

                    ],

                    dom:
                        "<'row mb-3'<'col-lg-6 col-md-8 col-sm-12'f>>" +
                        "<'row'<'col-12'tr>>" +
                        "<'row mt-3'<'col-lg-6 col-md-12'i><'col-lg-6 col-md-12'p>>",

                    language: {

                        search: "",

                        searchPlaceholder:
                            "Search complaint...",

                        emptyTable:
                            "No complaints found",

                        zeroRecords:
                            "No matching data",

                        info:
                            "Showing _START_ to _END_ of _TOTAL_ entries",

                        paginate: {

                            previous: "←",

                            next: "→"
                        }
                    }

                });

                $('.dataTables_filter input')
                    .addClass('form-control');

            },

            error: function (xhr) {

                console.log(xhr.responseText);

                alert('Load Failed');

            }

        });

    }
</script>
